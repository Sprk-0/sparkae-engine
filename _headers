# The one page permitted to connect off-origin. Identical to the policy above in
# every directive except connect-src.
#
# `/demo` gets the SAME permissive policy even though _redirects 301s it to
# demo-standalone.html: on that path the header rides a redirect response and is
# inert, but if Netlify's clean-URL resolution ever wins over the redirect, `/demo`
# serves demo.html and needs `connect-src *`. Choosing the permissive value here
# makes the ambiguous case fail towards a working demo rather than a silently
# broken one, and the widening is bounded to a path that serves either a redirect
# or demo.html itself.
/demo.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src *; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'

/demo
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src *; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'

# Filenames are not content-hashed, so anything cached hard has to be something
# that changes only when its name would. The fonts qualify; the catalog does
# not — it is regenerated whenever the NIST data behind it moves.
/static/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/demo-standalone-catalog.js
  Cache-Control: public, max-age=3600

/demo-exports.js
  Cache-Control: public, max-age=3600
